<Project Sdk="Microsoft.NET.Sdk">

  <!-- LOCAL-ONLY personal plugin. Deliberately lives OUTSIDE mods/ so the Thunderstore
       publish workflow (which only scans mods/) never sees it. Do not move it under
       mods/ and do not give it a Thunderstore manifest: it must never be published.
       Package set mirrors the bundles so UnityEngine resolves to the same facade and
       KeyCode does not collide; MMHOOK/R2API are compile-time refs only (the deployed
       artifact is just SilentPartner.dll). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>SilentPartner</AssemblyName>
    <RootNamespace>SilentPartner</RootNamespace>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Core" Version="5.4.21" />
    <PackageReference Include="MMHOOK.RoR2" Version="2025.6.3" />
    <PackageReference Include="R2API.Items" Version="1.0.7" />
    <PackageReference Include="RiskOfRain2.GameLibs" Version="1.3.9-r.0" />
    <PackageReference Include="UnityEngine" Version="5.6.1" />
    <PackageReference Include="UnityEngine.CoreModule" Version="2020.3.1" />
  </ItemGroup>

  <!-- local-only deploy to the Thunderstore Mod Manager test profile; skipped on CI -->
  <Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="'$(OS)' == 'Windows_NT' And '$(CI)' == ''">
    <Exec Command="xcopy &quot;.\bin\$(Configuration)\netstandard2.1\SilentPartner.dll&quot; &quot;C:\Users\cummi\AppData\Roaming\Thunderstore Mod Manager\DataFolder\RiskOfRain2\profiles\mod_testing\BepInEx\plugins\&quot; /Y" />
  </Target>

</Project>
